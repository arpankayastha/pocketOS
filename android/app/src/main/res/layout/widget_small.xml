<?xml version="1.0" encoding="utf-8"?>
<!-- Compact widget (2×1): just − and +, with a badge when bank payments wait to be added. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="5dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/sOut"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_out"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_icon_out"
                android:contentDescription="Spent"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_out" />
            <TextView
                android:id="@+id/sOutLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="Spent"
                android:textColor="@color/neg"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/sIn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_in"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_icon_in"
                android:contentDescription="Received"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_in" />
            <TextView
                android:id="@+id/sInLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="Received"
                android:textColor="@color/pos"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/sBadge"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_badge"
        android:gravity="center"
        android:minWidth="20dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="3"
        android:textColor="@color/bg"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
