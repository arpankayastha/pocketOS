<?xml version="1.0" encoding="utf-8"?>
<!-- Compact widget (2×1): just − and +, with a badge when bank payments wait to be added. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="6dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/sOut"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_out"
            android:contentDescription="Spent"
            android:scaleType="center"
            android:src="@drawable/ic_w_out" />
        <ImageView
            android:id="@+id/sIn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_in"
            android:contentDescription="Received"
            android:scaleType="center"
            android:src="@drawable/ic_w_in" />
    </LinearLayout>
    <TextView
        android:id="@+id/sBadge"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_badge"
        android:gravity="center"
        android:minWidth="20dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="3"
        android:textColor="@color/bg"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
