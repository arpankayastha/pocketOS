<?xml version="1.0" encoding="utf-8"?>
<!-- Large widget: − / + icon buttons, frequent Hisab entries as icon chips, and payments read
     from bank SMS waiting to be added (rows hidden when the widget is short). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/wHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/splash" />
        <TextView
            android:id="@+id/wTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Hisab"
            android:textColor="@color/muted"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/wBadge"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:background="@drawable/widget_badge"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="3 to add"
            android:textColor="@color/bg"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wButtons"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/wOut"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_circle_out"
            android:contentDescription="Spent"
            android:padding="13dp"
            android:src="@drawable/ic_w_out" />
        <ImageView
            android:id="@+id/wIn"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_circle_in"
            android:contentDescription="Received"
            android:padding="13dp"
            android:src="@drawable/ic_w_in" />
        <LinearLayout
            android:id="@+id/wPresets"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView android:id="@+id/p0" style="@style/WidgetChip" />
            <TextView android:id="@+id/p1" style="@style/WidgetChip" />
            <TextView android:id="@+id/p2" style="@style/WidgetChip" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wCaps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout android:id="@+id/c0" style="@style/WidgetCapRow">
            <TextView android:id="@+id/c0t" style="@style/WidgetCapText" />
            <TextView android:id="@+id/c0a" style="@style/WidgetCapAction" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c1" style="@style/WidgetCapRow">
            <TextView android:id="@+id/c1t" style="@style/WidgetCapText" />
            <TextView android:id="@+id/c1a" style="@style/WidgetCapAction" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/wPair"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_chip"
        android:gravity="center"
        android:text="Tap to pair with eChopdo"
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
